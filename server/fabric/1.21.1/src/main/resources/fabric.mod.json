{
  "schemaVersion": 1,
  "id": "minecraftauth",
  "version": "${version}",
  "name": "Minecraft Authentication",
  "description": "Authenticate players in your Minecraft server to various services",
  "authors": [
    "Minecraft Authentication"
  ],
  "license": "Apache-2.0",
  "environment": "server",
  "entrypoints": {
    "server": [
      "me.minecraftauth.fabric.server.MinecraftAuthMod"
    ]
  },
  "mixins": [
    {
      "config": "minecraftauth.mixins.json",
      "environment": "server"
    }
  ],
  "depends": {
    "fabricloader": ">=0.14.0",
    "minecraft": ">=1.18",
    "java": ">=17",
    "fabric-api": "*"
  }
}
